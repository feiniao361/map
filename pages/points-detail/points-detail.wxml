<view class="container">
  <!-- 积分总览 -->
  <view class="total-section">
    <text class="total-label">当前积分</text>
    <text class="total-points">{{totalPoints}}</text>
  </view>

  <!-- 积分明细 -->
  <view class="list-section">
    <block wx:if="{{!loading}}">
      <view wx:for="{{pointList}}" wx:key="id" class="list-item">
        <view class="item-left">
          <text class="item-type">{{item.transactionType === 'REWARD' ? '任务奖励' : '其他'}}</text>
          <text class="item-time">{{item.createdTime}}</text>
        </view>
        <text class="item-points">+{{item.points}}</text>
      </view>
    </block>
    <view wx:else class="loading">
      <text>加载积分明细中...</text>
    </view>
  </view>
</view>
