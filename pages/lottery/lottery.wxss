.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background-color: #2c9afc;
  padding: 20px;
}

.grid {
  display: flex;
  flex-wrap: wrap; /* 允许换行 */
  width: 530px; /* 根据需要调整 */
}

.grid-item {
  position: relative;
  width: 176px; /* 根据需要调整 */
  height: 171px; /* 根据需要调整 */
  margin: 10px; /* 间距 */
  display: flex;
  flex-direction: column; /* 垂直排列 */
  align-items: center;
  justify-content: center;
  border-radius: 20px;
  overflow: hidden;
  border: 1px solid #ccc; /* 边框 */
  transition: transform 0.5s, box-shadow 0.5s;
}

.background-light {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(173, 216, 230, 0.5);
  opacity: 0;
  transition: opacity 0.5s;
}

.grid-item.active .background-light {
  opacity: 1; /* 抽中时显示背景光 */
}

.start-button {
  margin-top: 20px;
  padding: 10px 20px;
  background-color: #007aff;
  color: white;
  border: none;
  border-radius: 5px;
  cursor: pointer;
}

.start-button:hover {
  background-color: #005bb5;
}

text {
  margin-top: 10px;
  font-size: 18px;
}

.title {
  text-align: center;
  margin-top: 10%;
  color: white;
}

#container {
  width: 330px;
  height: 340px;
  margin: 10% auto;
  border: 7px solid #99d4ff;
  border-radius: 10px;
  padding: 2%;
}

.lottery-list {
  list-style: none;
  margin: 0;
  padding: 0;
}

.lottery-list li {
  width: 100px;
  height: 100px;
  float: left;
  text-align: center;
  line-height: 100px;
  position: relative;
  background-color: #384f9a;
  margin: 1.4%;
  border-radius: 5px;
}

.lottery-list li image {
  display: block;
  width: 100%;
  height: 100%;
}

.mask {
  width: 100%;
  height: 100%;
  position: absolute;
  left: 0;
  top: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: none;
}

.lottery-list li.active .mask {
  display: block;
}

#message {
  line-height: 32px;
  color: #9a9a9a;
  text-align: center;
  position: absolute;
  left: 50%;
  top: 50px;
  width: 300px;
  height: 50px;
  margin-left: -150px;
  background: #000;
  color: #fff;
  transition: opacity 0.5s ease;
  opacity: 0; /* 初始状态为透明 */
}

#message.show {
  opacity: 1; /* 显示状态 */
}

/* 添加奖品滚动的动画效果 */
@keyframes scrollAnimation {
  0% { transform: scale(1); }
  50% { transform: scale(1.1); }
  100% { transform: scale(1); }
}

.lottery-list .active {
  animation: scrollAnimation 0.5s ease-in-out infinite;
} 