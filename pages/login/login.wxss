.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background: linear-gradient(135deg, #6dd5ed, #2193b0);
  padding: 20rpx;
}

.avatar-wrapper {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-bottom: 20rpx;
  background-color: #f0f0f0;
}

.avatar {
  width: 100%;
  height: 100%;
}

.nickname-wrapper {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nickname-label {
  font-size: 26rpx;
  color: #fff;
  margin-right: 10rpx;
}

.nickname-text {
  font-size: 24rpx;
  color: #fff;
}

.get-user-info-btn {
  width: 80%;
  padding: 15rpx;
  margin-top: 20rpx;
  background: linear-gradient(135deg, #43e97b, #38f9d7);
  color: #fff;
  font-size: 28rpx;
  text-align: center;
  border-radius: 50rpx;
  border: none;
}

.confirm-btn {
  width: 80%;
  padding: 15rpx;
  margin-top: 20rpx;
  background: linear-gradient(135deg, #ff758c, #ff7eb3);
  color: #fff;
  font-size: 28rpx;
  text-align: center;
  border-radius: 50rpx;
  border: none;
}

.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
}

.logo-container {
  margin-bottom: 40rpx;
}

.logo {
  width: 200rpx;
  height: 200rpx;
  border-radius: 30rpx;
  box-shadow: 0 8rpx 16rpx rgba(0,0,0,0.1);
}

.welcome-text {
  font-size: 36rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 60rpx;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.loading-dots {
  display: flex;
  gap: 8rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  background-color: #007AFF;
  border-radius: 50%;
  animation: loading 1.4s infinite ease-in-out;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes loading {
  0%, 100% {
    transform: scale(0.3);
    opacity: 0.3;
  }
  50% {
    transform: scale(1);
    opacity: 1;
  }
}