<!--components/task-list/task-list.wxml-->
<view class="task-list">
  <view class="task-header">
    <text class="task-title">{{taskTitle}}</text>
  </view>
  <view class="task-items">
    <view class="task-item" 
          wx:for="{{tasks}}" 
          wx:key="id" 
          bindtap="onTaskTap" 
          data-task-id="{{item.id}}">
      <view class="task-name">{{item.name}}</view>
      <view class="task-info">
        <text class="task-progress">{{item.progress}}</text>
        <text class="task-level">{{item.level}}</text> 
        <text class="task-distance">{{item.distance}}</text>
      </view>
    </view>
  </view>
</view>